@model ManejoTareas.Models.Tarea
@{
    ViewData["Title"] = "Detalle de Tarea";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>@ViewData["Title"]</h1>
        <a asp-action="Index" class="btn btn-secondary">Volver</a>
    </div>

    <div class="card" style="max-width: 600px;">
        <div class="card-header @(Model.Completada ? "bg-success text-white" : "bg-warning text-dark")">
            <h4 class="mb-0">@Model.Titulo</h4>
        </div>
        <div class="card-body">
            <p class="card-text">@Model.Descripcion</p>
            <dl class="row">
                <dt class="col-sm-4">Estado</dt>
                <dd class="col-sm-8">
                    <span class="badge @(Model.Completada ? "bg-success" : "bg-warning text-dark") fs-6">
                        @(Model.Completada ? "Completada" : "Pendiente")
                    </span>
                </dd>
                <dt class="col-sm-4">Fecha Creación</dt>
                <dd class="col-sm-8">@Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</dd>
                @if (Model.FechaActualizacion.HasValue)
                {
                    <dt class="col-sm-4">Última Actualización</dt>
                    <dd class="col-sm-8">@Model.FechaActualizacion.Value.ToString("dd/MM/yyyy HH:mm")</dd>
                }
                <dt class="col-sm-4">ID</dt>
                <dd class="col-sm-8">@Model.Id</dd>
            </dl>
            <div class="mt-3">
                <a asp-action="Complete" asp-route-id="@Model.Id" class="btn @(Model.Completada ? "btn-secondary" : "btn-success")">
                    @(Model.Completada ? "Marcar como Pendiente" : "Marcar como Completada")
                </a>
                @if (User.IsInRole("Admin") || User.IsInRole("Administrador"))
                {
                    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline" onsubmit="return confirm('¿Eliminar esta tarea?')">
                        <button type="submit" class="btn btn-danger">Eliminar</button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
