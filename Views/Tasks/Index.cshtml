@model ManejoTareas.ViewModels.TaskListViewModel
@{
    ViewData["Title"] = "Lista de Tareas";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>@ViewData["Title"]</h1>
        <a asp-action="Create" class="btn btn-primary">Nueva Tarea</a>
    </div>

    <div class="alert alert-secondary">
        <strong>Usuario:</strong> @Model.UserName |
        <strong>Total:</strong> @Model.TotalTasks |
        <strong>Completadas:</strong> @Model.CompletedTasks
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (Model.Tasks.Count == 0)
    {
        <div class="alert alert-info">No hay tareas. <a asp-action="Create">Crea la primera</a>.</div>
    }
    else
    {
        @foreach (var task in Model.Tasks)
        {
            <partial name="_TaskCard" model="task" />
        }

        <hr />
        <h5>Vista en tabla (compatibilidad)</h5>
        <table class="table table-striped table-hover mt-3">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Título</th>
                    <th>Descripción</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var task in Model.Tasks)
                {
                    <tr class="@(task.Completada ? "table-success" : "")">
                        <td>@task.Id</td>
                        <td class="@(task.Completada ? "text-decoration-line-through" : "")">@task.Titulo</td>
                        <td>@task.Descripcion</td>
                        <td>
                            <span class="badge @(task.Completada ? "bg-success" : "bg-warning text-dark")">
                                @(task.Completada ? "Completada" : "Pendiente")
                            </span>
                        </td>
                        <td class="text-center">
                            <a asp-action="Details" asp-route-id="@task.Id" class="btn btn-sm btn-info">Ver</a>
                            <a asp-action="Complete" asp-route-id="@task.Id" class="btn btn-sm @(task.Completada ? "btn-secondary" : "btn-success")">
                                @(task.Completada ? "Deshacer" : "Completar")
                            </a>
                            @if (User.IsInRole("Admin") || User.IsInRole("Administrador"))
                            {
                                <a asp-action="Delete" asp-route-id="@task.Id" class="btn btn-sm btn-danger">Eliminar</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
