@model ManejoTareas.DTOs.TareaDto
@{
    ViewData["Title"] = "Detalle de Tarea";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>@ViewData["Title"]</h1>
        <div>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a>
            <a asp-action="Index" class="btn btn-secondary">Volver</a>
        </div>
    </div>

    <div class="card" style="max-width: 600px;">
        <div class="card-header @(Model.Completada ? "bg-success text-white" : "bg-warning text-dark")">
            <h4 class="mb-0">@Model.Titulo</h4>
        </div>
        <div class="card-body">
            <p class="card-text">@Model.Descripcion</p>
            <dl class="row">
                <dt class="col-sm-3">Estado</dt>
                <dd class="col-sm-9">
                    <span class="badge @(Model.Completada ? "bg-success" : "bg-warning text-dark") fs-6">
                        @(Model.Completada ? "Completada" : "Pendiente")
                    </span>
                </dd>
                <dt class="col-sm-3">Fecha Creacion</dt>
                <dd class="col-sm-9">@Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</dd>
                @if (Model.FechaActualizacion.HasValue)
                {
                    <dt class="col-sm-3">Ultima Actualizacion</dt>
                    <dd class="col-sm-9">@Model.FechaActualizacion.Value.ToString("dd/MM/yyyy HH:mm")</dd>
                }
                <dt class="col-sm-3">ID</dt>
                <dd class="col-sm-9">@Model.Id</dd>
            </dl>
        </div>
    </div>
</div>