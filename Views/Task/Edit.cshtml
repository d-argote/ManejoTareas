@model ManejoTareas.DTOs.ActualizarTareaDto
@{
    ViewData["Title"] = "Editar Tarea";
    var tareaId = ViewBag.TareaId as int? ?? 0;
}

<div class="container mt-4">
    <h1>@ViewData["Title"]</h1>

    <div class="card mt-3" style="max-width: 600px;">
        <div class="card-body">
            <form asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <input type="hidden" name="id" value="@tareaId" />

                <div class="mb-3">
                    <label asp-for="Titulo" class="form-label"></label>
                    <input asp-for="Titulo" class="form-control" />
                    <span asp-validation-for="Titulo" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Descripcion" class="form-label"></label>
                    <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Descripcion" class="text-danger"></span>
                </div>

                <div class="mb-3 form-check">
                    <input asp-for="Completada" class="form-check-input" />
                    <label asp-for="Completada" class="form-check-label"></label>
                </div>

                <button type="submit" class="btn btn-primary">Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}