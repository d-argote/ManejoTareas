@model List<ManejoTareas.DTOs.UsuarioDto>
@{
    ViewData["Title"] = "Usuarios";
}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>@ViewData["Title"] <small class="text-muted fs-6">(@Model.Count)</small></h1>
        @if (User.HasClaim("permiso","usuarios.crear") || User.IsInRole("Administrador"))
        {
            <a asp-action="Create" class="btn btn-primary">Nuevo Usuario</a>
        }
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="alert alert-info">
        <strong>RLS:</strong> tabla <code>usuarios</code> con Row Level Security activa. Solo admin ve todos; usuarios normales solo se ven a si mismos (politica DB). 
        Vista actual filtrada a nivel app por permisos <code>usuarios.ver</code>.
    </div>

    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Email</th>
                <th>Roles</th>
                <th>Permisos</th>
                <th>Estado</th>
                <th>Ultimo acceso</th>
                <th class="text-center">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in Model)
            {
                <tr class="@(!u.Activo ? "table-secondary" : "")">
                    <td>@u.Id</td>
                    <td>@u.Nombre</td>
                    <td>@u.Email</td>
                    <td>
                        @foreach (var r in u.Roles)
                        {
                            var badge = r == "Administrador" ? "bg-danger" : r == "Editor" ? "bg-warning text-dark" : "bg-info text-dark";
                            <span class="badge @badge me-1">@r</span>
                        }
                    </td>
                    <td>
                        <small>
                            @if (u.Permisos.Any())
                            {
                                @string.Join(", ", u.Permisos)
                            }
                            else
                            {
                                <span class="text-muted">sin permisos</span>
                            }
                        </small>
                    </td>
                    <td>
                        @if (u.Activo)
                        {
                            <span class="badge bg-success">Activo</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactivo</span>
                        }
                    </td>
                    <td><small>@(u.UltimoAcceso?.ToString("dd/MM/yyyy HH:mm") ?? "-")</small></td>
                    <td class="text-center">
                        <a asp-action="Details" asp-route-id="@u.Id" class="btn btn-sm btn-info">Ver</a>
                        @if (User.HasClaim("permiso","usuarios.editar") || User.IsInRole("Administrador"))
                        {
                            <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-sm btn-warning">Editar</a>
                        }
                        @if (User.HasClaim("permiso","usuarios.gestionar_permisos") || User.IsInRole("Administrador"))
                        {
                            <a asp-action="GestionarPermisos" asp-route-id="@u.Id" class="btn btn-sm btn-dark">Permisos</a>
                        }
                        @if (User.HasClaim("permiso","usuarios.eliminar") || User.IsInRole("Administrador"))
                        {
                            <form asp-action="Delete" asp-route-id="@u.Id" method="post" class="d-inline" onsubmit="return confirm('Eliminar usuario @u.Email ?')">
                                <button type="submit" class="btn btn-sm btn-danger">Borrar</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
