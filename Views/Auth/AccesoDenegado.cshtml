@{
    ViewData["Title"] = "Acceso denegado";
}
<div class="text-center mt-5">
    <h1 class="display-4 text-danger">403 - Acceso denegado</h1>
    <p class="lead">No tienes permiso para realizar esta accion.</p>
    <p>Contacta al administrador para que te asigne el permiso necesario.</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">Volver al inicio</a>
    @if (!User.Identity?.IsAuthenticated ?? true)
    {
        <a asp-controller="Auth" asp-action="Login" class="btn btn-outline-secondary mt-3">Iniciar sesion</a>
    }
</div>
